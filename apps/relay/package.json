{
  "name": "@blackchat/relay",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --env test",
    "build": "wrangler deploy --dry-run --env \"\" --outdir dist",
